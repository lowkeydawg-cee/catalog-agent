# All settings are optional; these are the defaults.
CATALOG_INPUT_DIR=./input_images
CATALOG_PROCESSED_DIR=./processed_images
CATALOG_FAILED_DIR=./failed_images
CATALOG_DB_PATH=./catalog.db
CATALOG_LOG_FILE=./logs/catalog_agent.log
CATALOG_LOG_LEVEL=INFO
OLLAMA_HOST=http://localhost:11434
CATALOG_MODEL=llama3.2-vision
CATALOG_MAX_VALIDATION_RETRIES=3
CATALOG_REQUEST_TIMEOUT=300
CATALOG_MAX_IMAGE_SIDE=1120
